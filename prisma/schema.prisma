generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categoria {
  id       String    @id @default(cuid())
  nome     String
  produtos Produto[]
}

model Produto {
  id          String       @id @default(cuid())
  nome        String
  preco       Float
  precoAntigo Float?
  descricao   String
  imagem      String
  emOferta    Boolean      @default(false)
  avaliacao   Float?
  vendas      String?
  categoriaId String
  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  itensPedido ItemPedido[]
}

model Usuario {
  id      String   @id @default(cuid())
  nome    String
  email   String   @unique
  senha   String
  pedidos Pedido[]
}

model Pedido {
  id        String       @id @default(cuid())
  usuarioId String
  usuario   Usuario      @relation(fields: [usuarioId], references: [id])
  frete     Float
  total     Float
  itens     ItemPedido[]
}

model ItemPedido {
  id            String  @id @default(cuid())
  pedidoId      String
  pedido        Pedido  @relation(fields: [pedidoId], references: [id])
  produtoId     String
  produto       Produto @relation(fields: [produtoId], references: [id])
  quantidade    Int
  precoUnitario Float
}
